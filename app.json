{
  "expo": {
    "name": "GoFix Provider",
    "slug": "gofix-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F6E56"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gofix.provider",
      "config": {
        "googleMapsApiKey": "AIzaSyAZZUDlKkHTYtWoxioG9Oh-Pjp6bNtvfIc"
      },
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GoFix Provider tracks your location to show it to customers in real time during jobs.",
        "NSLocationWhenInUseUsageDescription": "GoFix Provider uses your location to show nearby jobs.",
        "NSCameraUsageDescription": "GoFix Provider needs camera access to take before/after photos of your work.",
        "NSPhotoLibraryUsageDescription": "GoFix Provider needs photo library access to attach work photos to jobs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gofix.provider",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAZZUDlKkHTYtWoxioG9Oh-Pjp6bNtvfIc"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-notifications"
    ],
    "owner": "marius911",
    "extra": {
      "eas": {
        "projectId": "26a3693c-75bb-4a47-b0fc-02c23efe07ad"
      }
    }
  }
}
